{
  "Exam JS State Tracker": {
    "prefix": "examjs",
    "body": [
      "const GOAL = ${1:2000};",
      "let total = 0;",
      "let count = 0;",
      "const items = [];",
      "",
      "const inputName = document.getElementById(\"${2:itemName}\");",
      "const inputValue = document.getElementById(\"${3:itemValue}\");",
      "const actionBtn = document.getElementById(\"${4:actionBtn}\");",
      "const outputLabel = document.getElementById(\"${5:outputLabel}\");",
      "",
      "function processEntry() {",
      "    const name = inputName ? inputName.value.trim() : \"\";",
      "    const val = parseFloat(inputValue.value);",
      "",
      "    if (isNaN(val) || val <= 0) {",
      "        alert(\"Please enter a valid positive number.\");",
      "        return;",
      "    }",
      "",
      "    count++;",
      "    total += val;",
      "    if (name) items.push(name);",
      "",
      "    const average = total / count;",
      "    let feedback = \"\";",
      "",
      "    if (total <= ${6:800}) {",
      "        feedback = \"${7:Initial progress, keep going!}\";",
      "    } else if (total <= ${8:1600}) {",
      "        feedback = \"${9:Good progress, staying balanced!}\";",
      "    } else if (total < GOAL) {",
      "        feedback = \"${10:Almost at the target!}\";",
      "    } else {",
      "        feedback = \"${11:Goal reached successfully!}\";",
      "    }",
      "",
      "    if (count > ${12:8} && total < GOAL) {",
      "        feedback += \" ${13:Warning: Too many entries without reaching goal!}\";",
      "    }",
      "",
      "    const itemsFormatted = items.length > 0 ? `[\\${items.join(\", \")}]` : \"[]\";",
      "    outputLabel.innerHTML = `Total: \\${total} | Average: \\${parseFloat(average.toFixed(2))} | Items: \\${itemsFormatted} | Feedback: <b>\\${feedback}</b>`;",
      "",
      "    if (inputName) inputName.value = \"\";",
      "    inputValue.value = \"\";",
      "    inputValue.focus();",
      "}",
      "",
      "actionBtn.addEventListener(\"click\", processEntry);"
    ],
    "description": "Exam JavaScript State Tracker with running total, count, average, string array tracking, 4 tiers and warning threshold"
  },
  "Exam JS Formula & Arrays": {
    "prefix": "examjsformula",
    "body": [
      "const readingsA = [];",
      "const readingsB = [];",
      "",
      "const inputA = document.getElementById(\"${1:inputA}\");",
      "const inputB = document.getElementById(\"${2:inputB}\");",
      "const calculateBtn = document.getElementById(\"${3:calculateBtn}\");",
      "const resultLabel = document.getElementById(\"${4:resultLabel}\");",
      "",
      "function evaluateFormula() {",
      "    const valA = parseFloat(inputA.value);",
      "    const valB = parseFloat(inputB.value);",
      "",
      "    if (isNaN(valA) || isNaN(valB)) {",
      "        alert(\"Invalid input\");",
      "        return;",
      "    }",
      "",
      "    readingsA.push(valA);",
      "    readingsB.push(valB);",
      "",
      "    const avgA = readingsA.reduce((sum, n) => sum + n, 0) / readingsA.length;",
      "    const avgB = readingsB.reduce((sum, n) => sum + n, 0) / readingsB.length;",
      "",
      "    const score = (${5:100} - valB) * 2 + Math.abs(valA - ${6:80}) * 0.5;",
      "",
      "    let status = \"\";",
      "    if (score <= ${7:10}) {",
      "        status = \"SAFE\";",
      "    } else if (score <= ${8:20}) {",
      "        status = \"WARNING\";",
      "    } else {",
      "        status = \"DANGER\";",
      "    }",
      "",
      "    resultLabel.textContent = `Average A: ${avgA.toFixed(2)} | Average B: ${avgB.toFixed(2)} | Score: ${score.toFixed(1)} | Status: ${status}`;",
      "    inputA.value = \"\";",
      "    inputB.value = \"\";",
      "}",
      "",
      "calculateBtn.addEventListener(\"click\", evaluateFormula);"
    ],
    "description": "Exam JS formula evaluator with arrays, averages, and multi-tier boundaries"
  },
