{
  "Exam JS State Tracker (Minimal)": {
    "prefix": "examjs",
    "body": [
      "let total = 0, count = 0;",
      "let items = \"\"; // String accumulator (or: const list = [];)",
      "",
      "function add() {",
      "    let name = document.getElementById(\"${1:a}\").value;",
      "    let val = Number(document.getElementById(\"${2:b}\").value);",
      "    if (!name || isNaN(val) || val <= 0) return alert(\"Invalid input\");",
      "",
      "    count++;",
      "    total += val;",
      "    items += name + \", \"; // Simple string tracking without array!",
      "",
      "    let avg = total / count;",
      "    let msg = \"\";",
      "",
      "    if (total <= ${3:5}) msg = \"Start studying regularly!\";",
      "    else if (total <= ${4:12}) msg = \"Good progress!\";",
      "    else if (total <= ${5:19}) msg = \"Almost ready!\";",
      "    else msg = \"Goal reached!\";",
      "",
      "    if (count > ${6:7} && total < ${7:20}) msg = \"Increase study time!\";",
      "",
      "    document.getElementById(\"${8:res}\").innerHTML =",
      "        \"Total: \" + total + \"<br>\" +",
      "        \"Average: \" + avg.toFixed(2) + \"<br>\" +",
      "        \"Subjects: [\" + items.slice(0, -2) + \"]<br>\" +",
      "        \"Status: \" + msg;",
      "",
      "    document.getElementById(\"${1:a}\").value = \"\";",
      "    document.getElementById(\"${2:b}\").value = \"\";",
      "}"
    ],
    "description": "Minimal JS state tracker with simple string accumulation, avg, 4 tiers and warning"
  },
