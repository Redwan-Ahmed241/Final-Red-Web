      "<?php",
      "\\$c1 = floatval(\\$_POST[\"ct1\"]);",
      "\\$c2 = floatval(\\$_POST[\"ct2\"]);",
      "\\$c3 = floatval(\\$_POST[\"ct3\"]);",
