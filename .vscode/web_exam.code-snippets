  "Exam PHP Ceiling Allocation (Minimal)": {
    "prefix": "examphpcalc",
    "body": [
      "<?php",
      "\\$demand   = floatval(\\$_POST[\"${1:a}\"]);",
      "\\$rate     = floatval(\\$_POST[\"${2:b}\"]);",
      "\\$capacity = floatval(\\$_POST[\"${3:c}\"]);",
      "",
      "\\$unitsNeeded = ceil(\\$demand / \\$capacity);",
      "\\$totalCap    = \\$unitsNeeded * \\$capacity;",
      "\\$empty       = \\$totalCap - \\$demand;",
      "\\$wastedCost  = \\$empty * \\$rate;",
      "",
      "\\$unusedPct = (\\$totalCap > 0) ? (\\$empty / \\$totalCap) * 100 : 0;",
      "\\$status = (\\$unusedPct <= 10) ? \"Efficient\" : ((\\$unusedPct <= 25) ? \"Acceptable\" : \"Wasteful\");",
      "",
      "echo \"Units Needed: \" . \\$unitsNeeded . \"<br>\";",
      "echo \"Empty Slots: \" . \\$empty . \"<br>\";",
      "echo \"Wasted Cost: \" . \\$wastedCost . \" BDT<br>\";",
      "echo \"Status: \" . \\$status;",
      "?>"
    ],
    "description": "Minimal procedural PHP ceil booking calculation without functions"
  },
  "Exam PHP Target Comparison (Minimal)": {
    "prefix": "examphptarget",
    "body": [
      "<?php",
      "\\$val1   = floatval(\\$_POST[\"${1:cred}\"]);",
      "\\$val2   = floatval(\\$_POST[\"${2:num_course}\"]);",
      "\\$target = floatval(\\$_POST[\"${3:tar_cred}\"]);",
      "",
      "\\$total = \\$val1 * \\$val2;",
      "",
      "// 4-Tier Categorization",
      "\\$cat = \"Poor\";",
      "if (\\$total >= 120)     \\$cat = \"Excellent\";",
      "elseif (\\$total >= 90)  \\$cat = \"Good\";",
      "elseif (\\$total >= 60)  \\$cat = \"Average\";",
      "",
      "// Target Comparison",
      "if (\\$total == \\$target) {",
      "    \\$state = \"Exactly at target (0 diff)\";",
      "} elseif (\\$total > \\$target) {",
      "    \\$state = \"Above target by \" . (\\$total - \\$target);",
      "} else {",
      "    \\$state = \"Below target by \" . (\\$target - \\$total);",
      "}",
      "",
      "echo \"Total: \" . \\$total . \"<br>\";",
      "echo \"Category: \" . \\$cat . \"<br>\";",
      "echo \"Comparison: \" . \\$state;",
      "?>"
    ],
    "description": "Minimal procedural PHP rate x duration vs target comparison without functions"
  },
  "Exam PHP Best 2 of 3 CT Marks (Minimal)": {
