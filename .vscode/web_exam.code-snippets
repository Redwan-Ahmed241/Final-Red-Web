  "Exam JS Password Strength & Regex": {
    "prefix": "examjspassword",
    "body": [
      "let attempts = 0;",
      "const inputPassword = document.getElementById(\"${1:passwordInput}\");",
      "const checkBtn = document.getElementById(\"${2:checkBtn}\");",
      "const statusLabel = document.getElementById(\"${3:statusLabel}\");",
      "",
      "function evaluatePassword() {",
      "    const p = inputPassword.value;",
      "    attempts++;",
      "    let score = 0;",
      "",
      "    // Length criteria (e.g. +10 points per 2 chars beyond 6)",
      "    if (p.length >= 6) {",
      "        score += Math.floor((p.length - 6) / 2) * 10;",
      "    }",
      "",
      "    // Regex criteria",
      "    if (/[A-Z]/.test(p)) score += 15;",
      "    if (/[a-z]/.test(p)) score += 15;",
      "    if (/[0-9]/.test(p)) score += 20;",
      "    if (/[!@#$%^&*]/.test(p)) score += 25;",
      "",
      "    // 5 Tiers",
      "    let lvl = (score <= 30) ? \"Very Weak\" : (score <= 50) ? \"Weak\" :",
      "              (score <= 70) ? \"Medium\" : (score <= 90) ? \"Strong\" : \"Very Strong\";",
      "",
      "    let msg = (score >= 100) ? \"Perfect Password! Success!\" : `Score: \\${score} - \\${lvl}`;",
      "",
      "    if (attempts > 8 && score < 71) {",
      "        msg += \" | Need practice! Tips: Add uppercase, digits & symbols.\";",
      "    }",
      "",
      "    statusLabel.innerHTML = msg;",
      "}",
      "",
      "checkBtn.addEventListener(\"click\", evaluatePassword);"
    ],
    "description": "Password strength scorer with regex patterns, score tiers, and attempt limit warning"
  },
  "Exam PHP Best 2 of 3 CT Marks": {
    "prefix": "examphpbest2",
    "body": [
      "<?php",
      "function processStudentMarks(\\$ct1, \\$ct2, \\$ct3, \\$mid, \\$final) {",
      "    // Best 2 CTs average: sum minus the lowest, divided by 2",
      "    \\$bestTwoAvg = ((\\$ct1 + \\$ct2 + \\$ct3) - min(\\$ct1, \\$ct2, \\$ct3)) / 2.0;",
      "    \\$grandTotal = \\$bestTwoAvg + \\$mid + \\$final;",
      "    \\$status = (\\$grandTotal > 54) ? \"Passed\" : \"Failed\";",
      "",
      "    return [",
      "        'bestAvg' => \\$bestTwoAvg,",
      "        'grandTotal' => \\$grandTotal,",
      "        'status' => \\$status",
      "    ];",
      "}",
      "",
      "if (\\$_SERVER[\"REQUEST_METHOD\"] == \"POST\") {",
      "    \\$c1 = floatval(\\$_POST['ct1']);",
      "    \\$c2 = floatval(\\$_POST['ct2']);",
      "    \\$c3 = floatval(\\$_POST['ct3']);",
      "    \\$m  = floatval(\\$_POST['mid']);",
      "    \\$f  = floatval(\\$_POST['final']);",
      "",
      "    \\$res = processStudentMarks(\\$c1, \\$c2, \\$c3, \\$m, \\$f);",
      "    echo \"Best 2 CT Avg: {\\$res['bestAvg']} | Grand Total: {\\$res['grandTotal']} | Status: <b>{\\$res['status']}</b>\";",
      "}",
      "?>"
    ],
    "description": "Calculate best 2 of 3 CT marks, total with mid and final, and check Pass/Fail status"
  },
  "Exam SQL 15 Query Archetypes": {
    "prefix": "examsqlqueries",
    "body": [
      "-- 1. Count rows per group (243, 251, 253, 261)",
      "SELECT ${1:Category}, COUNT(*) AS Total FROM ${2:items} GROUP BY ${1:Category};",
      "",
      "-- 2. Total and average per group (242, 252)",
      "SELECT ${1:Category}, SUM(${3:Price}) AS Revenue, AVG(${3:Price}) AS AvgPrice FROM ${2:items} GROUP BY ${1:Category};",
      "",
      "-- 3. Groups with more than 1 row (HAVING) (253)",
      "SELECT ${4:Status}, COUNT(*) AS Total FROM ${2:items} GROUP BY ${4:Status} HAVING COUNT(*) > 1;",
      "",
      "-- 4. Top 2 days by revenue in date range (242)",
      "SELECT ${5:SaleDate}, SUM(${3:Price}) AS Revenue FROM ${2:items} WHERE ${5:SaleDate} BETWEEN '2024-01-01' AND '2024-01-31' GROUP BY ${5:SaleDate} ORDER BY Revenue DESC LIMIT 2;",
      "",
      "-- 5. Substring LIKE with OR & ORDER BY (261)",
      "SELECT ${6:ItemName}, ${1:Category}, ${7:Rating} FROM ${2:items} WHERE ${7:Rating} > 4.5 OR ${6:ItemName} LIKE '%${8:Pen}%' ORDER BY ${7:Rating} DESC;",
      "",
      "-- 6. Multi-condition filter (AND) (261)",
      "SELECT ${6:ItemName}, ${3:Price} FROM ${2:items} WHERE ${3:Price} > 400 AND ${1:Category} = '${9:Electronics}';",
      "",
      "-- 7. Whole-table total net worth (Price * Stock) (261)",
      "SELECT SUM(${3:Price} * ${10:Stock}) AS NetWorth FROM ${2:items};",
      "",
      "-- 8. Count + Avg + Sum with HAVING on Avg (261)",
      "SELECT ${1:Category}, COUNT(*) AS Items, AVG(${7:Rating}) AS AvgRating, SUM(${10:Stock}) AS TotalStock FROM ${2:items} GROUP BY ${1:Category} HAVING AVG(${7:Rating}) > 4.4 ORDER BY AvgRating DESC;",
      "",
      "-- 9. Calculated expression in HAVING (261)",
      "SELECT ${1:Category}, SUM(${3:Price} * ${10:Stock}) AS Value FROM ${2:items} GROUP BY ${1:Category} HAVING SUM(${3:Price} * ${10:Stock}) > 100000 ORDER BY Value DESC;",
      "",
      "-- 10. Distinct dates count per group (242)",
      "SELECT ${1:Category}, AVG(${10:Stock}) FROM ${2:items} GROUP BY ${1:Category} HAVING COUNT(DISTINCT ${5:SaleDate}) >= 2;",
      "",
      "-- 11. Relative comparison against category average (252)",
      "SELECT i.${6:ItemName}, i.${3:Price}, CASE WHEN i.${3:Price} > (SELECT AVG(i2.${3:Price}) FROM ${2:items} i2 WHERE i2.${1:Category} = i.${1:Category}) THEN 'Top Seller' ELSE 'Regular Seller' END AS Status FROM ${2:items} i;",
      "",
      "-- 12. Conditional update with NOT EQUAL <> (243, 251, 252, 253)",
      "UPDATE ${2:items} SET ${4:Status} = 'Low' WHERE ${3:Price} < 1000 AND ${4:Status} <> 'Returned';",
      "",
      "-- 13. Fixed bonus with upper ceiling cap (243, 251)",
      "UPDATE ${2:items} SET ${3:Price} = ${3:Price} + 5000 WHERE ${3:Price} > 3000 AND (${3:Price} + 5000) <= 60000;",
      "",
      "-- 14. 10% discount (* 0.90) or 10% raise (* 1.10) (252, 253, 261)",
      "UPDATE ${2:items} SET ${3:Price} = ${3:Price} * 0.90 WHERE ${1:Category} = 'Furniture';",
      "",
      "-- 15. Update 2 columns at once (261)",
      "UPDATE ${2:items} SET ${7:Rating} = ${7:Rating} + 0.2, ${3:Price} = ${3:Price} * 1.10 WHERE ${7:Rating} BETWEEN 4.0 AND 4.5 AND ${3:Price} > 0;"
    ],
    "description": "All 15 SQL query archetypes from past exam papers (Trimesters 242 to 261)"
  }
